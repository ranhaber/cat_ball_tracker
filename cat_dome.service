[Unit]
Description=Cat Dome - Detection & Tracking System
After=network.target

[Service]
Type=simple
User=ranhaber
WorkingDirectory=/home/ranhaber/cat_ball_tracker
Environment=PATH=/home/ranhaber/cat_ball_tracker/venv/bin:/usr/bin
ExecStart=/home/ranhaber/cat_ball_tracker/start_Cat_Dome.sh
Restart=on-failure
RestartSec=10

# Logging (goes to both journald AND dated log files via wrapper script)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
